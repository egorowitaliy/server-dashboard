#!/usr/bin/env bash

config='/etc/server-dashboard/secrets.ini'

if [ ! -f "$config" ] && [ -f /opt/server-dashboard/secrets.ini ]; then
    config='/opt/server-dashboard/secrets.ini'
fi

if [ "$config" = '/etc/server-dashboard/secrets.ini' ] && [ ! -d /etc/server-dashboard ]; then
    install -d -o root -g server-dashboard-web -m 0750 /etc/server-dashboard
    rc=$?
    if [ "$rc" -ne 0 ]; then
        printf '[ERROR] Не удалось создать /etc/server-dashboard\n'
        exit 1
    fi
fi

username="${1:-admin}"

if [[ ! "$username" =~ ^[A-Za-z0-9_.@-]{1,64}$ ]]; then
    printf '[ERROR] Пользователь должен соответствовать [A-Za-z0-9_.@-], длина 1..64\n'
    exit 1
fi

printf 'Пользователь: %s\n' "$username"

IFS= read -r -s -p 'Новый пароль: ' pass1
printf '\n'
IFS= read -r -s -p 'Повторите пароль: ' pass2
printf '\n'

if [ -z "$pass1" ]; then
    printf '[ERROR] Пустой пароль запрещён\n'
    unset pass1 pass2
    exit 1
fi

if [ "$pass1" != "$pass2" ]; then
    printf '[ERROR] Пароли не совпадают\n'
    unset pass1 pass2
    exit 1
fi

hash="$(
    printf '%s' "$pass1" \
        | php -r '
            $p = stream_get_contents(STDIN);
            $hash = password_hash($p, PASSWORD_DEFAULT);
            if (!is_string($hash) || $hash === "") {
                exit(2);
            }
            echo $hash;
        '
)"
hash_rc=$?
unset pass1 pass2

if [ "$hash_rc" -ne 0 ] || [ -z "$hash" ]; then
    printf '[ERROR] Не удалось создать password hash\n'
    exit 1
fi

values="$(
    php -r '
        $path = $argv[1];
        $defaults = [28800, 3, 600, 900];
        if (is_file($path)) {
            $cfg = parse_ini_file($path, true, INI_SCANNER_TYPED);
            if (!is_array($cfg) || !isset($cfg["auth"]) || !is_array($cfg["auth"])) {
                fwrite(STDERR, "invalid existing secrets.ini\n");
                exit(2);
            }
            $auth = $cfg["auth"];
        } else {
            $auth = [];
        }
        $keys = [
            "session_idle_seconds",
            "max_failures",
            "failure_window_seconds",
            "lock_seconds",
        ];
        foreach ($keys as $i => $key) {
            $value = $auth[$key] ?? $defaults[$i];
            if (!is_int($value) || $value <= 0) {
                $value = $defaults[$i];
            }
            echo $value, "\n";
        }
    ' "$config"
)"
values_rc=$?

if [ "$values_rc" -ne 0 ]; then
    printf '[ERROR] Не удалось прочитать существующие настройки auth\n'
    exit 1
fi

mapfile -t auth_values <<< "$values"

if [ "${#auth_values[@]}" -ne 4 ]; then
    printf '[ERROR] Некорректный набор auth-настроек\n'
    exit 1
fi

session_idle_seconds="${auth_values[0]}"
max_failures="${auth_values[1]}"
failure_window_seconds="${auth_values[2]}"
lock_seconds="${auth_values[3]}"

tmp="$(mktemp "$(dirname "$config")/.secrets.ini.XXXXXX")"
tmp_rc=$?

if [ "$tmp_rc" -ne 0 ] || [ -z "$tmp" ]; then
    printf '[ERROR] Не удалось создать временный файл\n'
    exit 1
fi

cleanup_tmp()
{
    if [ -n "${tmp:-}" ] && [ -e "$tmp" ]; then
        rm -f "$tmp"
    fi
}

trap cleanup_tmp EXIT HUP INT TERM

{
    printf '[auth]\n'
    printf 'username = "%s"\n' "$username"
    printf 'password_hash = "%s"\n\n' "$hash"
    printf 'session_idle_seconds = %s\n' "$session_idle_seconds"
    printf 'max_failures = %s\n' "$max_failures"
    printf 'failure_window_seconds = %s\n' "$failure_window_seconds"
    printf 'lock_seconds = %s\n' "$lock_seconds"
} > "$tmp"
write_rc=$?

if [ "$write_rc" -ne 0 ]; then
    printf '[ERROR] Не удалось записать временный файл\n'
    exit 1
fi

chown root:server-dashboard-web "$tmp"
chown_rc=$?
if [ "$chown_rc" -ne 0 ]; then
    printf '[ERROR] Не удалось установить владельца secrets.ini\n'
    exit 1
fi

chmod 0640 "$tmp"
chmod_rc=$?
if [ "$chmod_rc" -ne 0 ]; then
    printf '[ERROR] Не удалось установить права secrets.ini\n'
    exit 1
fi

mv -f "$tmp" "$config"
mv_rc=$?
if [ "$mv_rc" -ne 0 ]; then
    printf '[ERROR] Не удалось атомарно заменить secrets.ini\n'
    exit 1
fi

tmp=''
trap - EXIT HUP INT TERM

printf '[OK] Пароль обновлён; существующие лимиты auth сохранены\n'
